# Sanity project — sanity.io/manage → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name, usually "production"
NEXT_PUBLIC_SANITY_DATASET=
# A fixed ISO date, never "vX" — see https://www.sanity.io/docs/api-versioning
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Shared secret with the Sanity webhook that hits /api/revalidate — generate
# a random string and set the same value in both places.
SANITY_REVALIDATE_SECRET=
